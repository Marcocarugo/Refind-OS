{
  "expo": {
    "name": "ReFind",
    "slug": "refind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "refind",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.refindos",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "REFIND utilizza il Bluetooth per intercettare i segnali dei dispositivi nelle vicinanze.",
        "NSBluetoothPeripheralUsageDescription": "REFIND utilizza il Bluetooth per intercettare i segnali dei dispositivi nelle vicinanze.",
        "NSLocationWhenInUseUsageDescription": "REFIND ha bisogno della posizione per stimare la distanza dai segnali intercettati.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yourname.refindos",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": ["expo-router"],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b902a629-acdc-4fd0-84c7-9ee7a6539d86"
      }
    }
  }
}
